---
import { site } from '../config/site';
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
const [first, ...rest] = site.name.split(' ');
---

<a href="/" class:list={['logo', { 'logo--inverted': inverted }]} aria-label={`${site.name}, ir al inicio`}>
  <svg class="logo__seal" viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="3" class="logo__bg" />
    <rect x="3" y="3" width="34" height="34" rx="1.5" fill="none" stroke="#cdb07a" stroke-width="0.8" />
    <text
      x="20"
      y="26.6"
      text-anchor="middle"
      fill="#cdb07a"
      font-family="'Cormorant Garamond', Garamond, Georgia, serif"
      font-weight="700"
      font-size="19"
      letter-spacing="0.5">AR</text
    >
  </svg>
  <span class="logo__words">
    <span class="logo__name">{first} <span class="logo__light">{rest.join(' ')}</span></span>
    <span class="logo__sub">Asesoría fiscal</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex: none;
    text-decoration: none;
    color: var(--navy-900);
    white-space: nowrap;
  }
  .logo__seal {
    flex: none;
    width: 42px;
    height: 42px;
  }
  .logo__bg {
    fill: var(--navy-800);
  }
  .logo__words {
    display: grid;
    line-height: 1;
  }
  .logo__name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .logo__light {
    font-weight: 500;
  }
  .logo__sub {
    margin-top: 0.2rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-700);
  }
  .logo--inverted {
    color: var(--ivory);
  }
  .logo--inverted .logo__sub {
    color: var(--gold-400);
  }
  .logo--inverted .logo__bg {
    fill: var(--navy-700);
  }
</style>
