---
import { site } from '../config/site';
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<a href="/" class:list={['logo', { 'logo--inverted': inverted }]} aria-label={`${site.name}, ir al inicio`}>
  <svg width="38" height="38" viewBox="0 0 36 36" aria-hidden="true">
    <rect width="36" height="36" rx="9" class="logo__bg" />
    <g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8">
      <polyline points="6.5 27 12 9.5 17.5 27" stroke="#fff" />
      <line x1="8.6" y1="20.6" x2="15.4" y2="20.6" stroke="#fff" />
      <path d="M21 27V9.5h4.6a4.4 4.4 0 0 1 0 8.8H21" stroke="#fff" />
      <line x1="24.6" y1="18.3" x2="29.5" y2="27" stroke="#2fd3a0" />
    </g>
  </svg>
  <span class="logo__text">AR <span class="logo__light">Fiscal</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--navy-900);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .logo__bg {
    fill: #102a4c;
  }
  .logo__light {
    font-weight: 500;
  }
  .logo--inverted {
    color: #fff;
  }
  .logo--inverted .logo__bg {
    fill: #1d4372;
  }
</style>
