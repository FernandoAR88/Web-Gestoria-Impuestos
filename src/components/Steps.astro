---
import { site } from '../config/site';
import Icon, { type IconName } from './Icon.astro';

const steps: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'user',
    title: 'Propuesta',
    text: 'Hablamos de tu caso y te enviamos los honorarios por escrito.',
  },
  {
    icon: 'upload',
    title: 'Facturas',
    text: `Nos las envías durante el trimestre, como muy tarde el día ${site.docsDeadlineDay} del mes de presentación.`,
  },
  {
    icon: 'eye',
    title: 'Papel de trabajo y borrador',
    text: 'Te enviamos el cálculo detallado y el resultado de cada modelo.',
  },
  {
    icon: 'send',
    title: 'Aprobación y presentación',
    text: 'Con tu visto bueno, presentamos en plazo y te enviamos el justificante.',
  },
];
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="step">
        <div class="step__num" aria-hidden="true">
          {['I', 'II', 'III', 'IV'][i]}
        </div>
        <div class="icon-badge icon-badge--green">
          <Icon name={s.icon} />
        </div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.5rem;
    counter-reset: step;
  }
  .step {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
  }
  .step__num {
    position: absolute;
    top: 1.1rem;
    right: 1.4rem;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--gold-600);
    line-height: 1;
  }
  .step p {
    color: var(--ink-soft);
    margin: 0;
  }
</style>
