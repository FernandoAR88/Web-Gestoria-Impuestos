---
import { singleModels, eur, withVat } from '../data/pricing';
---

<div class="table-wrap">
  <table>
    <caption class="sr-only">Precio por presentación de cada modelo sin suscripción</caption>
    <thead>
      <tr>
        <th scope="col">Modelo</th>
        <th scope="col">Qué es</th>
        <th scope="col">Periodicidad</th>
        <th scope="col" class="num">Precio + IVA</th>
      </tr>
    </thead>
    <tbody>
      {
        singleModels.map((m) => (
          <tr>
            <td>
              <span class="model-code">{m.code}</span>
            </td>
            <td>
              {m.name}
              {m.note && <div class="small muted">{m.note}</div>}
            </td>
            <td>{m.period}</td>
            <td class="num">
              <strong>{eur(m.price)}</strong>
              <div class="small muted">{eur(withVat(m.price))} con IVA</div>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
