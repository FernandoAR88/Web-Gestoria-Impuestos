---
import { upcomingDeadlines, formatDate, daysUntil } from '../data/calendar';
import Icon from './Icon.astro';

// Se calcula en el build y se actualiza en el navegador con la fecha real del visitante.
const now = new Date();
const next = upcomingDeadlines(now, 1)[0];
const days = daysUntil(next.date, now);
---

<div class="next-deadline" data-next-deadline>
  <div class="icon-badge">
    <Icon name="calendar" />
  </div>
  <div>
    <p class="next-deadline__label">Próximo plazo con Hacienda</p>
    <p class="next-deadline__title">
      <strong data-nd-date>{formatDate(next.date, { day: 'numeric', month: 'long' })}</strong>
      · <span data-nd-title>{next.title}</span>
    </p>
    <p class="next-deadline__meta">
      Modelos <span data-nd-models>{next.models.join(', ')}</span> · <span data-nd-days
        >{days === 0 ? 'vence hoy' : `quedan ${days} días`}</span
      >
    </p>
  </div>
</div>

<script>
  import { upcomingDeadlines, formatDate, daysUntil } from '../data/calendar';
  const root = document.querySelector<HTMLElement>('[data-next-deadline]');
  if (root) {
    const now = new Date();
    const next = upcomingDeadlines(now, 1)[0];
    const days = daysUntil(next.date, now);
    const set = (sel: string, text: string) => {
      const el = root.querySelector(sel);
      if (el) el.textContent = text;
    };
    set('[data-nd-date]', formatDate(next.date, { day: 'numeric', month: 'long' }));
    set('[data-nd-title]', next.title);
    set('[data-nd-models]', next.models.join(', '));
    set('[data-nd-days]', days === 0 ? 'vence hoy' : days === 1 ? 'queda 1 día' : `quedan ${days} días`);
  }
</script>

<style>
  .next-deadline {
    display: flex;
    gap: 1rem;
    align-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow);
  }
  .next-deadline .icon-badge {
    margin: 0;
    flex: none;
  }
  .next-deadline p {
    margin: 0;
  }
  .next-deadline__label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--green-700);
  }
  .next-deadline__title {
    color: var(--navy-900);
  }
  .next-deadline__meta {
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
