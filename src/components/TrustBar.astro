---
import { site } from '../config/site';
import Icon, { type IconName } from './Icon.astro';

// Solo se muestran afirmaciones verificables y activadas en la configuración.
const items: { icon: IconName; text: string }[] = [
  site.guarantees.noPermanence && { icon: 'refresh' as IconName, text: 'Sin permanencia' },
  { icon: 'file' as IconName, text: 'Papel de trabajo en cada presentación' },
  site.guarantees.approvalBeforeFiling && { icon: 'eye' as IconName, text: 'Nada se presenta sin tu visto bueno' },
  { icon: 'lock' as IconName, text: site.security.euDataOnly ? 'Datos cifrados en la UE' : 'Datos protegidos conforme al RGPD' },
  site.credentials.colaboradorSocialAEAT && { icon: 'shield' as IconName, text: 'Colaboradores sociales de la AEAT' },
  site.credentials.seguroRC && { icon: 'shield' as IconName, text: 'Seguro de responsabilidad civil' },
].filter(Boolean) as { icon: IconName; text: string }[];
---

<ul class="trust-bar">
  {
    items.map((i) => (
      <li>
        <Icon name={i.icon} size={20} />
        {i.text}
      </li>
    ))
  }
</ul>

<style>
  .trust-bar {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .trust-bar li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .trust-bar :global(svg) {
    color: var(--gold-600);
  }
</style>
