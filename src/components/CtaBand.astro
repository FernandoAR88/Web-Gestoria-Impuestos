---
import { site, whatsappUrl } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = '¿Hablamos de tus impuestos?',
  text = 'Cuéntanos tu caso y te enviamos una propuesta con los modelos que necesitas y sus honorarios, por escrito y sin compromiso.',
} = Astro.props;
---

<section class="section section--navy cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--gold" href="/contacto/?motivo=propuesta">Solicitar propuesta</a>
      <a class="btn btn--light" href={whatsappUrl()} rel="noopener">
        <Icon name="whatsapp" size={20} /> WhatsApp
      </a>
      <a class="cta-band__phone" href={`tel:${site.contact.phone}`}>
        <Icon name="phone" size={18} />{site.contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .cta-band__inner > div:first-child {
    max-width: 560px;
  }
  .cta-band p {
    margin: 0;
    font-size: 1.1rem;
  }
  .cta-band__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: 0 0.5rem;
  }
  .cta-band__phone:hover {
    color: var(--gold-400);
  }
</style>
