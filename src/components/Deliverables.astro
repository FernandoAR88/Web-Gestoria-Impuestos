---
import Icon, { type IconName } from './Icon.astro';

// Lo que recibe el cliente en cada presentación: el método de trabajo del despacho.
const items: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'file',
    title: 'Papel de trabajo',
    text: 'El cálculo factura a factura, con cada incidencia explicada.',
  },
  {
    icon: 'eye',
    title: 'Borrador del modelo',
    text: 'La declaración tal y como se presentará, con su resultado.',
  },
  {
    icon: 'check',
    title: 'Tu aprobación',
    text: 'Sin tu visto bueno, no presentamos nada.',
  },
  {
    icon: 'shield',
    title: 'Justificante y archivo',
    text: 'Presentado en plazo, con su justificante oficial.',
  },
];
---

<ol class="deliverables">
  {
    items.map((i) => (
      <li class="card deliverable">
        <div class="icon-badge icon-badge--green">
          <Icon name={i.icon} />
        </div>
        <h3>{i.title}</h3>
        <p class="muted">{i.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .deliverables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.5rem;
  }
  .deliverable {
    min-width: 0;
  }
</style>
