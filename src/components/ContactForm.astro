---
import { site } from '../config/site';

const { provider, action, successPath } = site.form;
const formAction = provider === 'netlify' ? successPath : action;
---

<form
  class="contact-form"
  name="contacto"
  method="POST"
  action={formAction}
  data-netlify={provider === 'netlify' ? 'true' : undefined}
  netlify-honeypot={provider === 'netlify' ? 'empresa_web' : undefined}
>
  {provider === 'netlify' && <input type="hidden" name="form-name" value="contacto" />}
  {provider === 'formspree' && <input type="hidden" name="_next" value={new URL(successPath, Astro.site).toString()} />}
  <p class="hp-field" aria-hidden="true">
    <label>No rellenes este campo <input name="empresa_web" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="grid grid-2" style="gap: 0 1rem;">
    <div class="field">
      <label for="cf-nombre">Nombre y apellidos</label>
      <input id="cf-nombre" name="nombre" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="cf-telefono">Teléfono <span class="muted">(opcional)</span></label>
      <input id="cf-telefono" name="telefono" type="tel" autocomplete="tel" />
    </div>
    <div class="field">
      <label for="cf-perfil">¿Cuál es tu situación?</label>
      <select id="cf-perfil" name="perfil" required>
        <option value="">Elige una opción</option>
        <option>Voy a darme de alta como autónomo</option>
        <option>Ya soy autónomo</option>
        <option>Tengo una sociedad</option>
        <option>Otra</option>
      </select>
    </div>
    <div class="field">
      <label for="cf-motivo">Motivo</label>
      <select id="cf-motivo" name="motivo" required>
        <option value="propuesta">Quiero una propuesta de honorarios</option>
        <option value="info">Quiero información</option>
        <option value="suelto">Quiero presentar un modelo concreto</option>
        <option value="cambio">Vengo de otra gestoría o asesoría</option>
        <option value="atrasados">Tengo trimestres atrasados</option>
      </select>
    </div>
    <div class="field">
      <label for="cf-servicio">Servicio que te interesa</label>
      <select id="cf-servicio" name="servicio">
        <option value="">Aún no lo sé</option>
        <option value="iva">IVA (303, 390, 349, 347)</option>
        <option value="retenciones">Retenciones (111, 115, 190, 180)</option>
        <option value="irpf">IRPF del autónomo (130, 036, renta)</option>
        <option value="varios">Varios de los anteriores</option>
      </select>
    </div>
    <div class="field">
      <label for="cf-volumen">Facturas al trimestre (emitidas y recibidas)</label>
      <select id="cf-volumen" name="volumen">
        <option value="">Aproximadamente…</option>
        <option>Menos de 50</option>
        <option>De 50 a 150</option>
        <option>De 150 a 400</option>
        <option>Más de 400</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="cf-mensaje">Cuéntanos brevemente tu caso</label>
    <textarea id="cf-mensaje" name="mensaje" placeholder="Actividad, si tienes empleados o local alquilado, si vendes a otros países de la UE..."></textarea>
  </div>

  <label class="checkbox">
    <input type="checkbox" name="acepta_privacidad" required />
    <span>
      He leído la información sobre <a href="/privacidad/">protección de datos</a>.
    </span>
  </label>

  <p class="small muted rgpd">
    <strong>Información básica sobre protección de datos.</strong> Responsable: {site.legal.ownerName}. Finalidad: responder a
    tu consulta y, si lo pides, enviarte una propuesta de honorarios. Legitimación: tu consentimiento y la aplicación de medidas precontractuales.
    Destinatarios: no se ceden datos a terceros salvo obligación legal; el formulario lo gestiona nuestro proveedor de alojamiento (Netlify, EE. UU.) con las garantías del RGPD. Derechos: acceso, rectificación, supresión y otros, como
    se explica en la <a href="/privacidad/">política de privacidad</a>.
  </p>

  <button class="btn btn--primary" type="submit">Enviar consulta</button>
  <p class="small muted">
    Te respondemos en menos de {site.contact.responseTime}. Si el formulario no funcionara, escríbenos a{' '}
    <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
  </p>
</form>

<script>
  // Rellena el formulario según el enlace de origen (?motivo=propuesta&servicio=iva).
  const params = new URLSearchParams(location.search);
  const setValue = (id: string, value: string | null) => {
    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    if (el && value && (el.tagName !== 'SELECT' || [...(el as HTMLSelectElement).options].some((o) => o.value === value))) {
      el.value = value;
    }
  };
  setValue('cf-motivo', params.get('motivo'));
  setValue('cf-servicio', params.get('servicio'));
</script>

<style>
  .contact-form {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(1.25rem, 4vw, 2rem);
    box-shadow: var(--shadow);
  }
  .rgpd {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }
</style>
