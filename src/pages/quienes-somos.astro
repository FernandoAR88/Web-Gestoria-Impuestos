---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Quiénes somos"
  description={`Conoce ${site.name}: asesoría fiscal online especializada en IVA, retenciones e IRPF de autónomos y pymes.`}
>
  <PageHero
    eyebrow="Quiénes somos"
    title={`${site.name}: asesoría fiscal online`}
    lead="Creemos que los impuestos de un autónomo deben estar documentados, explicados y presentados a tiempo. Por eso nos centramos en pocos modelos y revisamos cada uno a fondo."
    crumbs={[{ label: 'Quiénes somos' }]}
  />

  <section class="section">
    <div class="container grid grid-2">
      <div>
        <h2>Cómo entendemos este trabajo</h2>
        <ul class="check-list">
          <li><strong>Claridad.</strong> Honorarios por escrito, cálculos documentados y respuestas sin tecnicismos.</li>
          <li><strong>Prevención.</strong> Preferimos avisarte antes que arreglarlo después.</li>
          <li><strong>Especialización.</strong> Hacemos pocos modelos y los conocemos al detalle.</li>
          <li><strong>Responsabilidad.</strong> Si nos equivocamos, lo asumimos y lo pagamos nosotros.</li>
        </ul>
      </div>
      <div class="card">
        <h2 class="h3-like">Datos de la empresa</h2>
        <dl class="facts">
          <div><dt>Titular</dt><dd>{site.legal.ownerName}</dd></div>
          <div><dt>NIF</dt><dd>{site.legal.taxId}</dd></div>
          <div><dt>Domicilio</dt><dd>{site.legal.address}</dd></div>
          <div><dt>Colegiación / asociación</dt><dd>{site.legal.professionalBody}</dd></div>
          {site.credentials.seguroRC && (
            <div>
              <dt>Seguro de RC profesional</dt>
              <dd>
                {site.legal.insurer} · {site.credentials.seguroRCImporte}
              </dd>
            </div>
          )}
          <div><dt>Atención</dt><dd>{site.contact.hours}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .h3-like {
    font-size: 1.3rem;
  }
  .facts {
    margin: 0;
  }
  .facts div {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .facts div:last-child {
    border-bottom: 0;
  }
  .facts dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
</style>
