---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import NextDeadline from '../components/NextDeadline.astro';
import Steps from '../components/Steps.astro';
import Deliverables from '../components/Deliverables.astro';
import FeesNote from '../components/FeesNote.astro';
import Guarantees from '../components/Guarantees.astro';
import FaqList from '../components/FaqList.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { photoVar, photo } from '../lib/photos';
import { site } from '../config/site';
import { services, notCovered } from '../data/services';
import { faqs } from '../data/faq';

const homeFaqs = faqs.filter((f) =>
  ['¿Hay permanencia?', '¿Presentáis algo sin que yo lo vea antes?', '¿Y si os equivocáis vosotros?', '¿Puedo cambiarme desde otra gestoría o asesoría?'].includes(f.q),
);
const lead = site.team[0];
---

<BaseLayout
  title={`Asesoría fiscal online para autónomos y pymes | ${site.name}`}
  description={site.description}
>
  <!-- HERO -->
  <section class="hero" style={photoVar('hero')}>
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">{site.descriptor}</span>
        <h1>Tu IVA y tus retenciones, presentados a tiempo y sin sorpresas</h1>
        <p class="lead">
          Preparamos y presentamos tus modelos trimestrales y anuales con Hacienda. Antes de cada presentación recibes el{' '}
          <strong>papel de trabajo</strong> con el detalle del cálculo y el <strong>borrador</strong> para tu aprobación.
        </p>
        <div class="btn-row">
          <a class="btn btn--gold" href="/contacto/?motivo=propuesta">Solicitar propuesta <Icon name="arrow" size={18} /></a>
          <a class="btn btn--ghost-light" href="/como-funciona/">Cómo trabajamos</a>
        </div>
        <div class="hero__trust">
          <TrustBar />
        </div>
      </div>

      <div class="hero__visual" aria-label="Ejemplo del resumen del papel de trabajo que recibes antes de cada presentación">
        <NextDeadline />
        <div class="draft-card">
          <div class="draft-card__head">
            <span class="badge">Ejemplo</span>
            <span class="small muted">Papel de trabajo · 3.er trimestre</span>
          </div>
          <dl class="draft-card__rows">
            <div><dt>Facturas revisadas</dt><dd>46 emitidas · 118 recibidas</dd></div>
            <div><dt>IVA repercutido</dt><dd>3.150,00 €</dd></div>
            <div><dt>IVA soportado deducible</dt><dd>− 1.237,65 €</dd></div>
            <div class="draft-card__total"><dt>Modelo 303 · a ingresar</dt><dd>1.912,35 €</dd></div>
            <div><dt>Modelo 130 · a ingresar</dt><dd>486,20 €</dd></div>
          </dl>
          <div class="draft-card__actions">
            <span class="draft-card__btn"><Icon name="check" size={18} /> Aprobar el borrador</span>
            <span class="small muted">2 incidencias explicadas en el papel de trabajo</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Qué hacemos</span>
        <h2>Solo impuestos periódicos. Y los hacemos muy bien.</h2>
        <p class="lead">
          Nos especializamos en los modelos que todo autónomo y pequeña empresa tiene que presentar cada trimestre. Al centrarnos en
          ellos, podemos revisarlos a fondo, documentar cada cálculo y no fallar un plazo.
        </p>
      </div>
      <div class="grid grid-3">
        {
          services.map((s) => (
            <a class="card service-card" href={`/servicios/${s.slug}/`}>
              <div class="icon-badge">
                <Icon name={s.icon} />
              </div>
              <h3>{s.title}</h3>
              <p class="muted">{s.short}</p>
              <p class="service-card__models">
                {s.models.map((m) => (
                  <span class="model-code">{m.code}</span>
                ))}
              </p>
              <span class="service-card__more">
                Ver detalle <Icon name="arrow" size={16} />
              </span>
            </a>
          ))
        }
      </div>
      <p class="mt-2">
        ¿Necesitas presentar un modelo concreto o regularizar trimestres atrasados?
        <a href="/contacto/?motivo=suelto">Cuéntanos tu caso</a> y te enviamos una propuesta.
      </p>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Cómo funciona</span>
        <h2>De tus facturas al justificante de Hacienda en 4 pasos</h2>
        <p class="lead">Todo online, desde el móvil o el ordenador. Sin desplazamientos ni papeles.</p>
      </div>
      <Steps />
      <p class="text-center mt-2"><a href="/como-funciona/">Ver el proceso en detalle</a></p>
    </div>
  </section>

  <!-- MÉTODO Y HONORARIOS -->
  <section class="section" id="metodo">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Nuestro método</span>
        <h2>Cada presentación, documentada y aprobada por ti</h2>
        <p class="lead">
          Trabajamos como un despacho: cada cálculo queda justificado por escrito y nada se presenta sin tu conformidad.
        </p>
      </div>
      <Deliverables />
      <div class="mt-2">
        <FeesNote />
      </div>
    </div>
  </section>

  <PhotoBand
    image="despacho"
    quote="Cada cifra, justificada. Cada plazo, cumplido."
    caption="El rigor de un despacho · La cercanía de tu asesor"
  />

  <!-- GARANTÍAS -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nuestros compromisos</span>
        <h2>Confianza que puedes comprobar</h2>
        <p class="lead">No te pedimos que te fíes: te damos garantías por escrito en las condiciones del servicio.</p>
      </div>
      <Guarantees />
    </div>
  </section>

  <!-- QUIÉN ESTÁ DETRÁS -->
  <section class="section">
    <div class="container grid grid-2 who">
      <div>
        <span class="eyebrow">Quién está detrás</span>
        <h2>Personas reales, no un algoritmo</h2>
        <p class="lead">
          {site.name} es la asesoría fiscal online de {site.founder}. Automatizamos lo repetitivo para dedicar el tiempo a lo
          importante: revisar cada declaración y responderte cuando tienes una duda.
        </p>
        <ul class="check-list">
          <li>Un asesor fiscal revisa cada modelo antes de enviártelo.</li>
          <li>Te responde una persona en menos de {site.contact.responseTime}.</li>
          <li>Teléfono, WhatsApp y email con horario publicado.</li>
          {site.credentials.colaboradorSocialAEAT && <li>Somos colaboradores sociales de la Agencia Tributaria.</li>}
          {site.credentials.seguroRC && <li>Seguro de responsabilidad civil profesional contratado.</li>}
        </ul>
        <a href="/quienes-somos/">Conoce al equipo</a>
      </div>
      <div class="card who__card">
        {
          photo('fernando') ? (
            <img class="who__photo" src={photo('fernando')} alt={`Retrato de ${site.founder}`} width="160" height="200" />
          ) : (
            <div class="who__avatar" aria-hidden="true">
              <Icon name="user" size={40} />
            </div>
          )
        }
        <h3>{lead.name}</h3>
        <p class="muted mb-0">{lead.role}</p>
        <p class="small muted">{lead.credentials}</p>
        <p>{lead.bio}</p>
        <a class="btn btn--secondary" href="/seguridad/"><Icon name="lock" size={18} /> Cómo protegemos tus datos</a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- PARA QUIÉN -->
  <section class="section section--soft">
    <div class="container grid grid-2">
      <div class="card">
        <h2 class="h3-like">Es para ti si…</h2>
        <ul class="check-list">
          <li>Eres autónomo en estimación directa o tienes una pequeña sociedad.</li>
          <li>Quieres olvidarte de los plazos trimestrales de Hacienda.</li>
          <li>Valoras un trabajo documentado y revisado, con honorarios cerrados por escrito.</li>
          <li>Te basta con que todo sea online, con un asesor que te atienda cuando lo necesites.</li>
        </ul>
      </div>
      <div class="card">
        <h2 class="h3-like">De momento no podemos ayudarte con…</h2>
        <ul class="cross-list">
          {notCovered.map((n) => <li>{n}</li>)}
        </ul>
        <p class="small muted mt-2 mb-0">Preferimos decírtelo claro desde el principio.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <span class="eyebrow">Dudas frecuentes</span>
        <h2>Lo que nos suelen preguntar</h2>
      </div>
      <FaqList items={homeFaqs} />
      <p class="text-center mt-2"><a href="/preguntas-frecuentes/">Ver todas las preguntas</a></p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    position: relative;
    color: #d9dfe9;
    padding-block: clamp(4rem, 9vw, 7.5rem);
    background-color: var(--navy-900);
    background-image:
      linear-gradient(100deg, rgb(14 26 46 / 0.96) 0%, rgb(14 26 46 / 0.86) 48%, rgb(14 26 46 / 0.6) 100%),
      var(--photo, repeating-linear-gradient(90deg, rgb(205 176 122 / 0.06) 0 1px, transparent 1px 96px));
    background-size: cover;
    background-position: center;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-600), transparent);
  }
  .hero h1 {
    color: var(--ivory);
  }
  .hero .eyebrow {
    color: var(--gold-400);
  }
  .hero .lead {
    color: #d3dae5;
  }
  .hero .lead strong {
    color: var(--ivory);
  }
  .hero :global(.trust-bar) {
    color: #d3dae5;
  }
  .hero :global(.trust-bar svg) {
    color: var(--gold-400);
  }
  .hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.7rem);
    color: var(--ivory);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__copy .lead {
    max-width: 600px;
  }
  .hero__trust {
    margin-top: 2rem;
  }
  .hero__visual {
    display: grid;
    gap: 1rem;
  }
  /* Borrador con aspecto de documento: papel, membrete y doble filete */
  .draft-card {
    position: relative;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 1.6rem 1.6rem 1.4rem;
    box-shadow: var(--shadow-lg);
  }
  .draft-card::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--line);
    border-radius: 2px;
    pointer-events: none;
  }
  .draft-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .draft-card__rows {
    margin: 0;
  }
  .draft-card__rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--line);
  }
  .draft-card__rows dt {
    color: var(--ink-soft);
  }
  .draft-card__rows dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }
  .draft-card__total dt,
  .draft-card__total dd {
    color: var(--navy-900);
    font-weight: 700;
  }
  .draft-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.2rem;
  }
  .draft-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--navy-800);
    color: var(--ivory);
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 3px;
    font-size: 0.95rem;
  }
  .service-card {
    display: flex;
    flex-direction: column;
  }
  .service-card__models {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .service-card__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    color: var(--navy-600);
  }
  .who {
    align-items: center;
  }
  .who__photo {
    width: 160px;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--gold-600);
    margin-bottom: 1rem;
  }
  .who__avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ivory);
    border: 1px solid var(--gold-600);
    color: var(--navy-700);
    margin-bottom: 1rem;
  }
  .h3-like {
    font-size: 1.3rem;
  }
  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
