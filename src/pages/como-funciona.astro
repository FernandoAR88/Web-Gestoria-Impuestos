---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import Deliverables from '../components/Deliverables.astro';
import FeesNote from '../components/FeesNote.astro';
---

<BaseLayout
  title="Cómo trabajamos: papel de trabajo, borrador y aprobación"
  description="Nos envías tus facturas, te entregamos el papel de trabajo y el borrador para tu aprobación y presentamos tus impuestos en plazo. Así trabajamos."
>
  <PageHero
    eyebrow="Cómo trabajamos"
    title="Así trabajamos contigo cada trimestre"
    lead="Cuatro pasos, siempre iguales. Sabes qué toca, cuánto pagas y por qué."
    crumbs={[{ label: 'Cómo trabajamos' }]}
  />

  <section class="section">
    <div class="container">
      <Steps />
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">En cada presentación</span>
        <h2>Lo que recibes</h2>
      </div>
      <Deliverables />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FeesNote />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
