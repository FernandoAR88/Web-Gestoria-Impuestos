---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import { services, type Service } from '../../data/services';
import { singleModels, plans, eur } from '../../data/pricing';
import type { Faq } from '../../data/faq';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;

type Extra = {
  seoTitle: string;
  lead: string;
  intro: string[];
  forWhom: string[];
  weDo: string[];
  youDo: string[];
  planIds: string[];
  planNote?: string;
  guide?: { href: string; label: string }[];
  faqs: Faq[];
};

const extra: Record<string, Extra> = {
  iva: {
    seoTitle: 'Presentación del IVA online: modelos 303 y 390',
    lead: 'Calculamos tu IVA a partir de tus facturas, te enseñamos el resultado y lo presentamos en plazo. También el 390, el 349 y el 347 cuando te toquen.',
    intro: [
      'Cada trimestre tienes que declarar a Hacienda la diferencia entre el IVA que has cobrado en tus facturas y el IVA que has pagado en tus gastos deducibles. Es el modelo 303, y equivocarse suele salir caro: un gasto no deducible, una factura mal emitida o un plazo vencido acaban en recargos o requerimientos.',
      'Nosotros revisamos cada factura, aplicamos el tipo correcto, comprobamos qué IVA es deducible y te avisamos de cualquier cosa rara antes de presentar.',
    ],
    forWhom: [
      'Autónomos y sociedades que facturan con IVA en régimen general.',
      'Profesionales que venden servicios o productos a clientes de otros países de la UE (modelo 349).',
      'Quien supera 3.005,06 € al año con un mismo cliente o proveedor (modelo 347).',
    ],
    weDo: [
      'Revisamos tus facturas emitidas y recibidas y detectamos errores.',
      'Calculamos el IVA repercutido y el soportado deducible.',
      'Te enviamos el borrador con el resultado: a ingresar, a compensar o a devolver.',
      'Presentamos el modelo y, si quieres, domiciliamos el pago.',
      'Preparamos los resúmenes anuales (390 y 347) con los datos de todo el año.',
    ],
    youDo: ['Subir tus facturas del trimestre.', 'Aprobar el borrador.'],
    planIds: ['esencial', 'completo', 'plus'],
    planNote: 'El plan Esencial incluye los modelos 303 y 390. Los modelos 349 y 347 están incluidos a partir del plan Completo.',
    guide: [{ href: '/guias/modelo-303/', label: 'Guía del modelo 303' }],
    faqs: [
      {
        group: 'impuestos',
        q: '¿Qué pasa si un trimestre me sale a devolver?',
        a: 'En los tres primeros trimestres el saldo a tu favor se compensa en los siguientes. En el último trimestre puedes elegir entre pedir la devolución o seguir compensando.',
      },
      {
        group: 'impuestos',
        q: '¿Puedo pagar el IVA a plazos?',
        a: 'Sí, se puede solicitar un aplazamiento o fraccionamiento a Hacienda al presentar. Te explicamos los requisitos y lo tramitamos contigo.',
      },
    ],
  },
  retenciones: {
    seoTitle: 'Retenciones online: modelos 111, 115, 190 y 180',
    lead: 'Si pagas a profesionales, tienes trabajadores o alquilas un local, ingresamos tus retenciones cada trimestre y preparamos los resúmenes anuales.',
    intro: [
      'Cuando pagas a otro profesional, a un trabajador o al propietario de tu local, la ley te obliga a quedarte una parte del pago (la retención) e ingresarla en Hacienda en su nombre. Lo haces cada trimestre con los modelos 111 y 115, y una vez al año con sus resúmenes 190 y 180.',
      'Son modelos sencillos pero fáciles de olvidar, y los resúmenes anuales tienen que cuadrar al céntimo con lo presentado durante el año. Nosotros nos encargamos de que cuadren.',
    ],
    forWhom: [
      'Autónomos y sociedades que reciben facturas de profesionales con retención (abogados, diseñadores, consultores...).',
      'Quien tiene trabajadores en nómina.',
      'Quien alquila un local, oficina o nave para su actividad.',
    ],
    weDo: [
      'Identificamos en tus facturas y recibos qué pagos llevan retención.',
      'Comprobamos que el porcentaje aplicado es el correcto.',
      'Presentamos los modelos 111 y 115 cada trimestre.',
      'Preparamos los resúmenes anuales 190 y 180 cuadrados con los trimestres.',
    ],
    youDo: ['Subir las facturas de profesionales y los recibos del alquiler.', 'Si tienes trabajadores, enviarnos las nóminas o el resumen de tu gestor laboral.'],
    planIds: ['completo', 'plus'],
    guide: [
      { href: '/guias/modelo-111/', label: 'Guía del modelo 111' },
      { href: '/guias/modelo-115/', label: 'Guía del modelo 115' },
    ],
    faqs: [
      {
        group: 'impuestos',
        q: '¿Hacéis las nóminas?',
        a: 'No: nos centramos en la parte fiscal. Si tienes trabajadores, nos basta con el resumen de nóminas que te prepare tu gestor laboral para presentar el 111 y el 190.',
      },
      {
        group: 'impuestos',
        q: 'Si un trimestre no he pagado a ningún profesional, ¿tengo que presentar el 111?',
        a: 'Por regla general no, si no has pagado ninguna renta sujeta a retención. Lo revisamos cada trimestre para que no presentes de más ni de menos.',
      },
    ],
  },
  'irpf-autonomos': {
    seoTitle: 'Modelo 130, alta de autónomo y renta online',
    lead: 'Te damos de alta en Hacienda, presentamos tus pagos a cuenta del IRPF cada trimestre y hacemos tu declaración de la renta con todos tus datos ya revisados.',
    intro: [
      'Como autónomo en estimación directa, cada trimestre adelantas a Hacienda el 20 % de tu beneficio acumulado del año (modelo 130). Después, en la renta, se hace la cuenta definitiva.',
      'Llevar bien los trimestres hace que la renta no dé sustos. Y como ya tenemos todos tus ingresos y gastos, tu declaración anual es mucho más rápida y barata.',
    ],
    forWhom: [
      'Autónomos en estimación directa (normal o simplificada).',
      'Personas que van a empezar una actividad y necesitan darse de alta (modelo 036).',
      'Autónomos que quieren que la renta la haga quien ya conoce sus números.',
    ],
    weDo: [
      'Tramitamos tu alta, modificaciones y baja en Hacienda (modelo 036).',
      'Calculamos el pago fraccionado trimestral con tus ingresos y gastos deducibles.',
      'Te avisamos si estás exento del 130 (cuando el 70 % o más de tus ingresos ya lleva retención).',
      'Preparamos tu declaración de la renta con tu actividad y tus demás rentas.',
    ],
    youDo: ['Subir tus facturas y gastos.', 'En la renta, darnos acceso a tus datos fiscales y contarnos los cambios personales del año.'],
    planIds: ['esencial', 'completo', 'plus'],
    planNote: 'La declaración de la renta está incluida en los planes Completo y Plus; con el plan Esencial cuesta 59 € + IVA.',
    guide: [{ href: '/guias/modelo-130/', label: 'Guía del modelo 130' }],
    faqs: [
      {
        group: 'impuestos',
        q: '¿Os encargáis también del alta en la Seguridad Social?',
        a: 'Nos centramos en Hacienda. El alta en el RETA la puedes hacer online en pocos minutos y te enviamos una guía paso a paso al darte de alta con nosotros.',
      },
      {
        group: 'impuestos',
        q: '¿Hacéis autónomos en módulos?',
        a: 'De momento no: solo estimación directa. Si estás en módulos (modelo 131), te lo diremos claramente antes de contratar.',
      },
    ],
  },
};

const e = extra[service.slug];
const related = singleModels.filter((m) => service.models.some((sm) => m.code === sm.code));
const relevantPlans = plans.filter((p) => e.planIds.includes(p.id));
---

<BaseLayout title={e.seoTitle} description={e.lead}>
  <PageHero
    eyebrow="Servicio"
    title={service.title === 'IVA' ? 'Presentación del IVA' : service.title}
    lead={e.lead}
    crumbs={[{ href: '/servicios/', label: 'Servicios' }, { label: service.title }]}
  >
    <div class="btn-row mt-2">
      <a class="btn btn--primary" href="/precios/">Ver planes</a>
      <a class="btn btn--secondary" href={`/contacto/?motivo=info`}>Consultar mi caso</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container grid grid-2 svc">
      <div class="prose">
        {e.intro.map((p) => <p>{p}</p>)}
        <h2>¿A quién le toca?</h2>
        <ul class="check-list">
          {e.forWhom.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <aside class="card svc__aside">
        <h2 class="svc__aside-title">Modelos incluidos</h2>
        <ul class="svc__models">
          {
            service.models.map((m) => (
              <li>
                <span class="model-code">{m.code}</span>
                <div>
                  <strong>{m.name}</strong>
                  <p class="small muted">{m.who}</p>
                  <p class="small">
                    <Icon name="calendar" size={14} class="inline-icon" /> {m.when}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container grid grid-2">
      <div class="card">
        <h2 class="h3-like">Lo que hacemos nosotros</h2>
        <ul class="check-list">
          {e.weDo.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="card">
        <h2 class="h3-like">Lo único que haces tú</h2>
        <ul class="check-list">
          {e.youDo.map((i) => <li>{i}</li>)}
        </ul>
        {
          e.guide && (
            <p class="mt-2 mb-0">
              ¿Quieres entenderlo a fondo?{' '}
              {e.guide.map((g, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={g.href}>{g.label}</a>
                </>
              ))}
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Precio</span>
        <h2>Cuánto cuesta</h2>
        <p class="lead">Incluido en los planes {relevantPlans.map((p) => p.name).join(', ').replace(/, ([^,]*)$/, ' y $1')}, o por presentación si lo prefieres.</p>
        {e.planNote && <p class="muted">{e.planNote}</p>}
      </div>
      <div class="grid grid-3">
        {
          relevantPlans.map((p) => (
            <a class:list={['card', 'mini-plan', { 'mini-plan--hl': p.highlighted }]} href={`/contacto/?motivo=alta&plan=${p.id}`}>
              <h3>Plan {p.name}</h3>
              <p class="mini-plan__price">
                {eur(p.monthly)} <span>/mes + IVA</span>
              </p>
              <p class="small muted mb-0">{p.audience}</p>
            </a>
          ))
        }
      </div>
      {
        related.length > 0 && (
          <p class="mt-2">
            Sin suscripción:{' '}
            {related.map((m, i) => (
              <>
                {i > 0 && ' · '}
                modelo {m.code} por <strong>{eur(m.price)}</strong> + IVA
              </>
            ))}
            . <a href="/precios/#modelos-sueltos">Ver todos los modelos sueltos</a>.
          </p>
        )
      }
    </div>
  </section>

  <section class="section section--soft">
    <div class="container container--narrow">
      <h2>Preguntas sobre este servicio</h2>
      <FaqList items={e.faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .svc {
    align-items: start;
  }
  .svc__aside {
    position: sticky;
    top: 96px;
  }
  .svc__aside-title {
    font-size: 1.2rem;
  }
  .svc__models {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .svc__models li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .svc__models li:last-child {
    border-bottom: 0;
  }
  .svc__models p {
    margin: 0.2rem 0 0;
  }
  .svc__models :global(.inline-icon) {
    display: inline;
    vertical-align: -2px;
  }
  .h3-like {
    font-size: 1.3rem;
  }
  .mini-plan h3 {
    margin-bottom: 0.2rem;
  }
  .mini-plan--hl {
    border: 2px solid var(--green-600);
  }
  .mini-plan__price {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 0.4rem;
  }
  .mini-plan__price span {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .svc__aside {
      position: static;
    }
  }
</style>
