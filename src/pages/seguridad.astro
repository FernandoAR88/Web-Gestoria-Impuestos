---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { site } from '../config/site';

const sec = site.security;
// Solo se anuncian las medidas marcadas como implantadas en site.security.
const blocks = [
  {
    icon: 'lock' as IconName,
    title: sec.encryptionAtRest ? 'Cifrado en tránsito y en reposo' : 'Conexión cifrada',
    text: sec.encryptionAtRest
      ? 'Toda la comunicación con la web va cifrada (HTTPS/TLS) y tus documentos se guardan cifrados.'
      : 'Toda la comunicación con la web va cifrada mediante HTTPS/TLS.',
  },
  sec.euDataOnly && {
    icon: 'shield' as IconName,
    title: 'Servidores en la Unión Europea',
    text: 'Alojamos tus datos en proveedores con centros de datos en la UE y contrato de encargo del tratamiento conforme al RGPD.',
  },
  {
    icon: 'user' as IconName,
    title: 'Acceso mínimo',
    text: `Solo acceden a tu documentación las personas que preparan tus declaraciones${sec.twoFactor ? ', con verificación en dos pasos y registro de accesos' : ''}.`,
  },
  {
    icon: 'file' as IconName,
    title: 'Secreto profesional',
    text: 'Toda persona con acceso a tus datos firma un compromiso de confidencialidad. Nunca cedemos ni vendemos tus datos.',
  },
  {
    icon: 'refresh' as IconName,
    title: sec.dailyBackups ? 'Copias de seguridad diarias' : 'Conservación y entrega',
    text: sec.dailyBackups
      ? 'Copias automáticas diarias y conservación durante los plazos legales. Si te vas, te entregamos tu documentación completa.'
      : 'Conservamos tu documentación durante los plazos legales. Si te vas, te la entregamos completa.',
  },
].filter(Boolean) as { icon: IconName; title: string; text: string }[];
---

<BaseLayout
  title="Seguridad y protección de datos"
  description="Cómo protegemos tu información fiscal: conexión cifrada, acceso mínimo, confidencialidad y cumplimiento del RGPD."
>
  <PageHero
    eyebrow="Seguridad"
    title="Tu información fiscal, protegida"
    lead="Nos confías datos muy sensibles. Esto es lo que hacemos para protegerlos, explicado sin letra pequeña."
    crumbs={[{ label: 'Seguridad y privacidad' }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {
          blocks.map((b) => (
            <div class="card">
              <div class="icon-badge icon-badge--green">
                <Icon name={b.icon} />
              </div>
              <h2 class="h3-like">{b.title}</h2>
              <p class="muted">{b.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container container--narrow prose">
      <div class="notice notice--amber">
        <p>
          <strong>Aviso de seguridad:</strong> nunca te pediremos tus claves de Cl@ve, tu certificado digital ni los datos de tu tarjeta por
          email, WhatsApp o teléfono. Si recibes un mensaje así en nuestro nombre, no respondas y avísanos en{' '}
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
        </p>
      </div>
      <h2>Tus derechos</h2>
      <p>
        Puedes acceder a tus datos, rectificarlos, suprimirlos, oponerte a su tratamiento o pedir su portabilidad escribiendo a{' '}
        <a href={`mailto:${site.legal.dpoEmail}`}>{site.legal.dpoEmail}</a>. Tienes toda la información en nuestra{' '}
        <a href="/privacidad/">política de privacidad</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .h3-like {
    font-size: 1.2rem;
  }
</style>
